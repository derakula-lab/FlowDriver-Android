<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <!-- ══ Top bar ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FlowDriver"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#E8EAED"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TUN"
            android:textSize="11sp"
            android:textColor="#6E7681"
            android:fontFamily="monospace"
            android:layout_marginEnd="6dp"/>

        <Switch
            android:id="@+id/swTunnel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="@color/switch_thumb"
            android:trackTint="@color/switch_track"
            android:layout_marginEnd="12dp"/>

        <ImageButton
            android:id="@+id/btnProfileMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/btn_icon_bg"
            android:contentDescription="Profiles menu"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="#6E7681" />

    </LinearLayout>

    <!-- ══ Profile chips ══ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:id="@+id/llProfileChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"/>
    </HorizontalScrollView>

    <!-- ══ Active profile card ══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="#161B22"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#C9D1D9"/>

                <TextView
                    android:id="@+id/tvListenAddr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textSize="12sp"
                    android:textColor="#444D56"
                    android:fontFamily="monospace"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnEditProfile"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/btn_icon_bg"
                android:contentDescription="Edit profile"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="#6E7681" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ══ Big connect button area ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Uptime -->
        <TextView
            android:id="@+id/tvUptime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textSize="14sp"
            android:textColor="#444D56"
            android:fontFamily="monospace"
            android:layout_marginBottom="28dp"/>

        <!-- Round button -->
        <View
            android:id="@+id/btnConnect"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/btn_connect_off"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Status label -->
        <TextView
            android:id="@+id/tvStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TAP TO CONNECT"
            android:textSize="13sp"
            android:textColor="#546E7A"
            android:letterSpacing="0.1"
            android:layout_marginTop="24dp"/>
    </LinearLayout>

    <!-- ══ Log card ══ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#0D1117"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOG"
                android:textSize="10sp"
                android:textColor="#30363D"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp"/>

            <ScrollView
                android:id="@+id/svLog"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="#6E7681"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"/>
            </ScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>